{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["ocrengine"],
  "ios": {
    "iosModuleName": "OcrEngine"
  },
  "android": {
    "androidNamespace": ["ocrengine"],
    "androidCxxLibName": "OcrEngine"
  },
  "autolinking": {
    "OcrEngine": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridOcrEngine"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridOcrEngine"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
