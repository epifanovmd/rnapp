<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <!-- База splash-темы для Android < 12: картинку рисует windowBackground. -->
    <style name="Theme.AppSplash" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_compat</item>
        <item name="android:opacity">opaque</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Тема запуска activity: ассеты генерируются `npm run splash`. -->
    <style name="BootTheme" parent="Theme.AppSplash">
        <item name="splashBackground">@color/splash_background</item>
        <item name="splashLogo">@drawable/splash_logo</item>
        <item name="splashBrand">@drawable/splash_brand</item>
        <item name="postSplashTheme">@style/AppTheme</item>
    </style>
</resources>
